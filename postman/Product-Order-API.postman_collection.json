{
  "info": {
    "_postman_id": "0f40a5ca-fd59-4e9d-8244-d2e06e070b84",
    "name": "Product Order API",
    "description": "Collection for validating the Products and Orders APIs, including product categories and order filters.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "keycloakUrl", "value": "http://localhost:8081" },
    { "key": "keycloakClientId", "value": "product-order-api" },
    { "key": "keycloakClientSecret", "value": "product-order-api-local-secret" },
    { "key": "jwt", "value": "COLE_SEU_JWT_AQUI" },
    { "key": "idempotencyKey", "value": "order-create-001" },
    { "key": "productId", "value": "1" },
    { "key": "orderId", "value": "1" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Generate JWT",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const token = pm.response.json().access_token;",
                  "pm.test('access_token returned', () => pm.expect(token).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('jwt', token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "client_credentials", "type": "text" },
                { "key": "client_id", "value": "{{keycloakClientId}}", "type": "text" },
                { "key": "client_secret", "value": "{{keycloakClientSecret}}", "type": "text" }
              ]
            },
            "url": "{{keycloakUrl}}/realms/product-order/protocol/openid-connect/token"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": { "method": "GET", "url": "{{baseUrl}}/actuator/health" },
          "response": []
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Create product",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Mouse sem fio\",\n  \"sku\": \"MOUSE-001\",\n  \"description\": \"Mouse óptico sem fio\",\n  \"category\": \"Periféricos\",\n  \"price\": 99.90,\n  \"stock\": 10,\n  \"weightKg\": 0.120\n}" },
            "url": "{{baseUrl}}/api/v1/products"
          },
          "response": []
        },
        {
          "name": "List products",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/products?page=0&size=20&sort=name,asc"
          },
          "response": []
        },
        {
          "name": "List product categories",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/products/categories"
          },
          "response": []
        },
        {
          "name": "Get product",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/products/{{productId}}"
          },
          "response": []
        },
        {
          "name": "Update product",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }] },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Mouse sem fio atualizado\",\n  \"sku\": \"MOUSE-001\",\n  \"description\": \"Mouse óptico sem fio, versão atualizada\",\n  \"category\": \"Periféricos\",\n  \"price\": 109.90,\n  \"stock\": 15,\n  \"weightKg\": 0.120\n}" },
            "url": "{{baseUrl}}/api/v1/products/{{productId}}"
          },
          "response": []
        },
        {
          "name": "Filter products",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/products?name=mouse&category=Perif%C3%A9ricos&minPrice=50&maxPrice=200&minWeight=0.050&maxWeight=1.000&page=0&size=20"
          },
          "response": []
        },
        {
          "name": "Import CSV",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }] },
            "method": "POST",
            "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "", "disabled": false }] },
            "url": "{{baseUrl}}/api/v1/products/import"
          },
          "response": []
        },
        {
          "name": "Delete product",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }] },
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/products/{{productId}}"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create order",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"items\": [\n    { \"productId\": {{productId}}, \"quantity\": 2 }\n  ]\n}" },
            "url": "{{baseUrl}}/api/v1/orders"
          },
          "response": []
        },
        {
          "name": "List orders",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/orders?page=0&size=20"
          },
          "response": []
        },
        {
          "name": "Filter orders by status",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/orders?status=CONFIRMED&page=0&size=20"
          },
          "response": []
        },
        {
          "name": "Filter order by ID",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/orders?id={{orderId}}&page=0&size=20"
          },
          "response": []
        },
        {
          "name": "Get order",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/orders/{{orderId}}"
          },
          "response": []
        }
      ]
    }
  ]
}
